# Backend URL; /api is added automatically when omitted
VITE_API_URL=http://localhost:5000/api

# Optional: If omitted, MapView fetches a short-lived token from /api/mappls/token
VITE_MAPPLS_ACCESS_TOKEN=

# Firebase Client Configuration (Firebase Auth + Cloud Firestore + Hosting)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
